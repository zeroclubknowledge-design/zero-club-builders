{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/gift/:code",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|[Ww]hats[Aa]pp|TelegramBot|Slackbot|Discordbot|Pinterest|SkypeUriPreview|Iframely|Embedly|Googlebot|bingbot|Applebot|facebookcatalog|meta-externalagent|vkShare|Viber|redditbot|Snapchat).*"
        }
      ],
      "destination": "https://www.zeroclubs.xyz/api/link-preview?kind=gift&id=:code"
    },
    {
      "source": "/app/gifts/:code",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|[Ww]hats[Aa]pp|TelegramBot|Slackbot|Discordbot|Pinterest|SkypeUriPreview|Iframely|Embedly|Googlebot|bingbot|Applebot|facebookcatalog|meta-externalagent|vkShare|Viber|redditbot|Snapchat).*"
        }
      ],
      "destination": "https://www.zeroclubs.xyz/api/link-preview?kind=gift&id=:code"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
