# Copy to keystore.properties and fill in. That file is gitignored.
#
# You normally do not create this by hand - scripts/generate-keystore.mjs writes
# it for you. It exists here so the expected shape is documented.
#
# Environment variables take precedence over this file, which is how CI supplies
# credentials without ever writing them to disk:
#   BUBBLEWRAP_KEYSTORE_PASSWORD
#   BUBBLEWRAP_KEY_PASSWORD

storeFile=android.keystore
keyAlias=zeroclub-upload
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
