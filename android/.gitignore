# ---------------------------------------------------------------------------
# Key material. Never commit any of this.
#
# android.keystore identifies the app to Google Play. If it leaks, someone else
# can sign builds that Android will accept as Zero Club.
# ---------------------------------------------------------------------------
*.keystore
*.jks
*.p12
*.pepk
keystore.properties
play-service-account*.json

# ---------------------------------------------------------------------------
# Generated by Bubblewrap. twa-manifest.json is the source of truth; everything
# below is regenerated from it on every build, so committing it only creates
# merge conflicts and lets the checked-in project drift from the manifest.
# ---------------------------------------------------------------------------
.build/
.twa/
out/

# Belt and braces, in case anyone runs `bubblewrap init` directly in here.
app/
gradle/
build/
.gradle/
gradlew
gradlew.bat
build.gradle
settings.gradle
gradle.properties
local.properties
manifest-checksum.txt
app-release-signed.apk
app-release-bundle.aab
app-release-unsigned-aligned.apk
store_icon.png
