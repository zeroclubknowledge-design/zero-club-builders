{
  "version": 2,
  "outputDirectory": "dist/client",
  "cleanUrls": true,
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 120,
      "includeFiles": "dist/server/**"
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "clipboard-write=(self \"https://checkout.paystack.com\" \"https://standard.paystack.co\" \"https://js.paystack.co\")"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "zeroclubs.xyz"
        }
      ],
      "destination": "https://www.zeroclubs.xyz/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/_next/(.*)",
      "destination": "/_next/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/api/og/:kind/:id",
      "destination": "/api/og?kind=:kind&id=:id"
    },
    {
      "source": "/api/og-default",
      "destination": "/api/og?kind=default&id=brand"
    },
    {
      "source": "/api/club-image/:id",
      "destination": "/api/og?kind=club&id=:id"
    },
    {
      "source": "/api/game-image/:id",
      "destination": "/api/og?kind=game&id=:id"
    },
    {
      "source": "/api/gift-image/:id",
      "destination": "/api/og?kind=gift&id=:id"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
